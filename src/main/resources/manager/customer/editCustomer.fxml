<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="450.0" prefWidth="550.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manager.customer.EditCustomerController">
    <stylesheets>
        <URL value="@editcustomer.css" />
    </stylesheets>
   <children>
      <VBox alignment="TOP_CENTER" spacing="25.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="35.0" AnchorPane.rightAnchor="35.0" AnchorPane.topAnchor="25.0">
         <children>
            <Label fx:id = "title" text="EDIT CUSTOMER INFORMATION" textFill="#4527a0">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            
            <GridPane hgap="15.0" vgap="20.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="160.0" minWidth="10.0" prefWidth="140.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="280.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Customer ID:" />
                  <TextField fx:id="txtId" editable="false" prefHeight="35.0" style="-fx-background-color: #f1f3f5; -fx-border-color: #dee2e6; -fx-border-radius: 5;" GridPane.columnIndex="1" />
                  
                  <Label text="Full Name:" GridPane.rowIndex="1" />
                  <TextField fx:id="txtName" prefHeight="35.0" promptText="Enter full name" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <Label text="Phone Number:" GridPane.rowIndex="2" />
                  <TextField fx:id="txtPhone" prefHeight="35.0" promptText="Enter phone number" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  
                  <Label text="Email Address:" GridPane.rowIndex="3" />
                  <TextField fx:id="txtEmail" prefHeight="35.0" promptText="example@domain.com" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  
                  <Label text="Loyalty Points:" GridPane.rowIndex="4" />
                  <Label fx:id="lblPoints" text="0 pts" textFill="#ff8f00" GridPane.columnIndex="1" GridPane.rowIndex="4">
                     <font>
                        <Font name="System Bold" size="15.0" />
                     </font>
                  </Label>
                  
                  <Label text="Registration Date:" GridPane.rowIndex="5" />
                  <Label fx:id="lblRegisDate" text="01/01/2026" GridPane.columnIndex="1" GridPane.rowIndex="5">
                     <font>
                        <Font name="System Italic" size="14.0" />
                     </font>
                  </Label>
               </children>
            </GridPane>
            
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <Button onAction="#onUpdate" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="UPDATE" />
                  <Button onAction="#onCancel" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-cursor: hand;" text="CANCEL" />
               </children>
               <padding><Insets top="15.0" /></padding>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>