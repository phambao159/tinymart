<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" prefWidth="400.0" style="-fx-background-color: white; -fx-border-color: #dcdde1; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manager.supplier.AddImportDetailController">
    <children>
        <Label text="Import Product Detail" textFill="#2f3640">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Separator prefWidth="200.0" />
        
        <GridPane vgap="12.0" hgap="10.0">
          <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="230.0" />
          </columnConstraints>
          <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          </rowConstraints>
           <children>
              <Label text="Product Name:" GridPane.rowIndex="0" />
              <Label fx:id="lbProductName" text="Product Name" GridPane.columnIndex="1" GridPane.rowIndex="0">
                 <font><Font name="System Bold" size="14.0" /></font>
              </Label>
              
              <Label text="Select Size:" GridPane.rowIndex="1" />
              <ComboBox fx:id="cbSize" prefWidth="230.0" promptText="Choose size..." GridPane.columnIndex="1" GridPane.rowIndex="1" />
              
              <Label text="Import Quantity:" GridPane.rowIndex="2" />
              <TextField fx:id="txtQuantity" prefWidth="230.0" text="1" GridPane.columnIndex="1" GridPane.rowIndex="2" />
           </children>
        </GridPane>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#onCancel" prefWidth="80.0" text="Cancel" style="-fx-background-color: #f1f2f6;" />
                <Button mnemonicParsing="false" onAction="#onAdd" prefWidth="100.0" text="Add to List" style="-fx-background-color: #00a8ff; -fx-text-fill: white; -fx-font-weight: bold;" />
            </children>
            <VBox.margin>
                <Insets top="15.0" />
            </VBox.margin>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>