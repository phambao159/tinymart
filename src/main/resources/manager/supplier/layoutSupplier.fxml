<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<AnchorPane id="AnchorPane" prefHeight="700.0" prefWidth="750.0" styleClass="mainFxmlClass" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="controller.manager.supplier.LayoutSupplierController">
    <stylesheets>
        <URL value="@layoutSupplier.css" />
    </stylesheets>
    
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="46.0" prefWidth="685.0" spacing="10.0">
            <children>
                <ToggleButton mnemonicParsing="false" onAction="#onSupplierList" selected="true" text="Supplier List">
               <toggleGroup>
                  <ToggleGroup fx:id="toggleSupplier" />
               </toggleGroup>
                </ToggleButton>
            <ToggleButton mnemonicParsing="false" onAction="#onImport" text="Import List" toggleGroup="$toggleSupplier" />
                </children>
        </HBox>
         
        <StackPane fx:id="viewSupplier" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="58.0" />
    </children>
</AnchorPane>
