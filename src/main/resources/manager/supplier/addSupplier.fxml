<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="450.0" prefWidth="500.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manager.supplier.AddSupplierController">
    <stylesheets>
        <URL value="@addsupplier.css" />
    </stylesheets>
   <children>
      <VBox alignment="TOP_CENTER" spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="20.0">
         <children>
            <Label text="ADD NEW SUPPLIER" textFill="#28a745">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            
            <GridPane hgap="10.0" vgap="15.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="130.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="270.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="80.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="3.0">
                     <children>
                        <Label text="Supplier Name" />
                        <Label text="*" textFill="#e74c3c" style="-fx-font-weight: bold;" />
                     </children>
                  </HBox>
                  <TextField fx:id="txtName" promptText="Enter supplier name" GridPane.columnIndex="1" />
                  
                  <HBox alignment="CENTER_LEFT" spacing="3.0" GridPane.rowIndex="1">
                     <children>
                        <Label text="Contact Person" />
                        <Label text="*" textFill="#e74c3c" style="-fx-font-weight: bold;" />
                     </children>
                  </HBox>
                  <TextField fx:id="txtContactPerson" promptText="Enter contact person name" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <HBox alignment="CENTER_LEFT" spacing="3.0" GridPane.rowIndex="2">
                     <children>
                        <Label text="Phone Number" />
                        <Label text="*" textFill="#e74c3c" style="-fx-font-weight: bold;" />
                     </children>
                  </HBox>
                  <TextField fx:id="txtPhone" promptText="Enter phone number" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  
                  <HBox alignment="TOP_LEFT" spacing="3.0" GridPane.rowIndex="3">
                     <children>
                        <Label text="Address" />
                        <Label text="*" textFill="#e74c3c" style="-fx-font-weight: bold;" />
                     </children>
                     <padding>
                        <Insets top="5.0" />
                     </padding>
                  </HBox>
                  <TextArea fx:id="txtAddress" prefHeight="80.0" promptText="Enter full address" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               </children>
            </GridPane>
            
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onSave" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="ADD" />
                  <Button mnemonicParsing="false" onAction="#onCancel" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-cursor: hand;" text="CANCEL" />
               </children>
               <padding>
                  <Insets top="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>