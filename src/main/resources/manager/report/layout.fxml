<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="2000" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manager.report.DashboardController">
    <stylesheets>
        <URL value="@layout.css" />
    </stylesheets>
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox fx:id="cardRevenue" alignment="CENTER" prefHeight="113.0" prefWidth="205.0" spacing="10.0" styleClass="vbox-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="lbTitleRevenue" text="Total Revenue (Last 30days)">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="revenue" text="+1000">
                                    <font>
                                        <Font name="System Bold" size="26.0" />
                                    </font>
                                </Label>
                                <Label fx:id="subRevenue" text="+15% vs last Month">
                                    <font>
                                        <Font size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <VBox fx:id="cardOrder" alignment="CENTER" prefHeight="113.0" prefWidth="205.0" spacing="10.0" styleClass="vbox-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="lbTitleOrder" text="Total Order ( Today )">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="order" text="35">
                                    <font>
                                        <Font name="System Bold" size="26.0" />
                                    </font>
                                </Label>
                                <Label fx:id="subOrder" text="+10% vs Yesterday">
                                    <font>
                                        <Font size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <VBox fx:id="cardCategory" alignment="CENTER" prefHeight="113.0" prefWidth="205.0" spacing="10.0" styleClass="vbox-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="lbCategory" text="Top Category">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="category" text="Snacks &amp; Drinks">
                                    <font>
                                        <Font name="System Bold" size="26.0" />
                                    </font>
                                </Label>
                                <Label fx:id="subCategory" text="Best seller this week">
                                    <font>
                                        <Font size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <VBox fx:id="cardCustomer" alignment="CENTER" prefHeight="113.0" prefWidth="205.0" spacing="10.0" styleClass="vbox-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="lbCustomer" text="New Customers">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="customer" text="+45">
                                    <font>
                                        <Font name="System Bold" size="26.0" />
                                    </font>
                                </Label>
                                <Label fx:id="subCustomer" text="+5% vs last month">
                                    <font>
                                        <Font size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" prefHeight="35.0" prefWidth="820.0" />
                <HBox prefHeight="580.0" prefWidth="2000" spacing="20.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox prefHeight="506.0" prefWidth="2004.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" prefHeight="46.0" prefWidth="685.0" spacing="10.0">
                                    <children>
                                        <ToggleButton mnemonicParsing="false" onAction="#onRevenue" selected="true" text="Revenue">
                                            <toggleGroup>
                                                <ToggleGroup fx:id="toggleReport" />
                                            </toggleGroup>
                                        </ToggleButton>
                                        <ToggleButton mnemonicParsing="false" onAction="#onTop10" text="Top 10 Selling Product" toggleGroup="$toggleReport" />
           
                                    </children>
                                </HBox>
                                <StackPane fx:id="viewReport" prefHeight="461.0" prefWidth="1089.0" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
