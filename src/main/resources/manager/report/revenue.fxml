<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="2000" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manager.report.RevenueController">
    <stylesheets>
        <URL value="@revenue.css" />
    </stylesheets>
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="34.0" spacing="10.0" style="-fx-padding: 10 0 0 10;">
                    <children>
                        <Label prefHeight="17.0" prefWidth="58.0" text="Period : " />
                        <ComboBox fx:id="periodyear" prefWidth="150.0" promptText="2026" />
                        <ComboBox fx:id="periodmonth" prefWidth="150.0" promptText="All" />
                    </children>
                </HBox>
                
                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <children>
                        <BarChart fx:id="barChartRevenue" animated="false" prefHeight="569.0" title="Revenue by Period" HBox.hgrow="ALWAYS">
                            <xAxis>
                                <CategoryAxis label="Date" side="BOTTOM" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="Revenue (VNĐ)" side="LEFT" />
                            </yAxis>
                        </BarChart>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>