<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="580.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manager.employee.EditEmployeeController">
    <stylesheets>
        <URL value="@editemployee.css" />
    </stylesheets>
   <children>
      <VBox alignment="TOP_CENTER" spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="15.0">
         <children>
            <Label text="EDIT EMPLOYEE" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            
            <GridPane hgap="10.0" vgap="12.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="140.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="3.0" GridPane.rowIndex="0">
                     <children>
                        <Label text="Full Name:" />
                        <Label text="*" textFill="RED" />
                     </children>
                  </HBox>
                  <TextField fx:id="txtName" GridPane.columnIndex="1" />
                  
                  <HBox alignment="CENTER_LEFT" spacing="3.0" GridPane.rowIndex="1">
                     <children>
                        <Label text="Birth Date:" />
                        <Label text="*" textFill="RED" />
                     </children>
                  </HBox>
                  <DatePicker fx:id="dpDob" prefWidth="350.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <HBox alignment="CENTER_LEFT" spacing="3.0" GridPane.rowIndex="2">
                     <children>
                        <Label text="Phone Number:" />
                        <Label text="*" textFill="RED" />
                     </children>
                  </HBox>
                  <TextField fx:id="txtPhone" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  
                  <HBox alignment="CENTER_LEFT" spacing="3.0" GridPane.rowIndex="3">
                     <children>
                        <Label text="Address:" />
                        <Label text="*" textFill="RED" />
                     </children>
                  </HBox>
                  <TextField fx:id="txtAddress" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  
                  <HBox alignment="CENTER_LEFT" spacing="3.0" GridPane.rowIndex="4">
                     <children>
                        <Label text="Role:" />
                        <Label text="*" textFill="RED" />
                     </children>
                  </HBox>
                  <ComboBox fx:id="cbRole" prefWidth="350.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  
                  <HBox alignment="CENTER_LEFT" spacing="3.0" GridPane.rowIndex="5">
                     <children>
                        <Label text="Base Salary:" />
                        <Label text="*" textFill="RED" />
                     </children>
                  </HBox>
                  <TextField fx:id="txtSalary" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                  
                  <HBox alignment="CENTER_LEFT" spacing="3.0" GridPane.rowIndex="6">
                     <children>
                        <Label text="Username:" />
                        <Label text="*" textFill="RED" />
                     </children>
                  </HBox>
                  <TextField fx:id="txtUser" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                  
                  <HBox alignment="CENTER_LEFT" spacing="3.0" GridPane.rowIndex="7">
                     <children>
                        <Label text="Password:" />
                        <Label text="*" textFill="RED" />
                     </children>
                  </HBox>
                  <TextField fx:id="txtPassword" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                  
                  <HBox alignment="CENTER_LEFT" spacing="3.0" GridPane.rowIndex="8">
                     <children>
                        <Label text="Hire Date:" />
                        <Label text="*" textFill="RED" />
                     </children>
                  </HBox>
                  <DatePicker fx:id="dpHireDate" prefWidth="350.0" GridPane.columnIndex="1" GridPane.rowIndex="8" />
               </children>
            </GridPane>
            
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button onAction="#onUpdate" prefHeight="35.0" prefWidth="110.0" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="UPDATE" />
                  <Button onAction="#onCalculateSalary" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="CALC SALARY" />
                  <Button onAction="#onDeleteInsideEdit" prefHeight="35.0" prefWidth="110.0" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="DELETE" />
                  <Button onAction="#onClose" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-cursor: hand;" text="CANCEL" />
               </children>
               <padding><Insets top="15.0" /></padding>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>