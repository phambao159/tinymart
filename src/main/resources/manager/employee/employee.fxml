<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="500.0" prefWidth="800.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manager.employee.EmployeeController">
    <stylesheets>
        <URL value="@employee.css" />
    </stylesheets>
    <children>
      <VBox alignment="TOP_CENTER" spacing="10.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <TextField fx:id="txtSearch" prefWidth="250.0" promptText="Search by name or phone..." />
                  <Button mnemonicParsing="false" onAction="#onAdd" style="-fx-background-color: #1E8449; -fx-text-fill: white;" text="+ New Employee" />
               </children>
            </HBox>

            <TableView fx:id="tbEmployee" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colID" maxWidth="100.0" minWidth="50.0" text="ID" />
                  <TableColumn fx:id="colName" prefWidth="250.0" text="Full Name" />
                  <TableColumn fx:id="colPhone" prefWidth="150.0" text="Phone Number" />
                  <TableColumn fx:id="colRole" prefWidth="120.0" text="Role" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
    </children>
</AnchorPane>
