<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="700.0" spacing="15.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manager.order.OrderDetailController">
    <stylesheets>
        <URL value="@orderdetail.css" />
    </stylesheets>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="ORDER DETAILS" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
        
        <GridPane hgap="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 10;" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints prefWidth="120.0" />
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints prefWidth="120.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" />
            </rowConstraints>
            <children>
                <Label text="Order ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="lbOrderID" style="-fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                
                <Label text="Order Date:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <Label fx:id="lbDate" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                
                <Label text="Customer:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label fx:id="lbCustomer" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                
                <Label text="Cashier:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <Label fx:id="lbEmployee" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            </children>
        </GridPane>

        <TableView fx:id="tbDetail" prefHeight="300.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colProduct" prefWidth="250.0" text="Product Name" />
                <TableColumn fx:id="colPrice" prefWidth="120.0" text="Unit Price" />
                <TableColumn fx:id="colQuantity" prefWidth="100.0" text="Quantity" />
                <TableColumn fx:id="colSubTotal" prefWidth="150.0" text="Subtotal" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <VBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Label style="-fx-font-size: 14px;" text="Product Discount:" />
                        <Label fx:id="prDiscount" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="0.00" textFill="#e74c3c" />
                    </children>
                </HBox>
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Label style="-fx-font-size: 14px;" text="Point Discount:" />
                  <Label fx:id="pDiscount" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="0.00" textFill="#e74c3c" />
               </children>
            </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Total Amount:" />
                        <Label fx:id="lbTotal" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="0.00" textFill="#1e8449" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
