<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="500.0" prefWidth="800.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manager.product.CategoryController">
    <stylesheets>
        <URL value="@category.css" />
    </stylesheets>
    <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0" styleClass="top-bar">
                <children>
                    <TextField fx:id="txtSearch" onAction="#onSearch" prefWidth="300.0" promptText="Search category name..." styleClass="search-field" />
                    <Button mnemonicParsing="false" onAction="#onAdd" styleClass="add-button" text="+ New Category" />
                    <HBox alignment="CENTER" spacing="10.0" styleClass="filter-group">
                       <children>
                          <RadioButton fx:id="rbActive" mnemonicParsing="false" selected="true" text="Active">
                             <toggleGroup>
                                <ToggleGroup fx:id="statusGroup" />
                             </toggleGroup>
                          </RadioButton>
                          <RadioButton fx:id="rbInactive" mnemonicParsing="false" text="Inactive" toggleGroup="$statusGroup" />
                       </children>
                    </HBox>
                </children>
            </HBox>

            <TableView fx:id="tbCategory" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colID" maxWidth="100.0" minWidth="80.0" prefWidth="90.0" style="-fx-alignment: CENTER;" text="ID" />
                <TableColumn fx:id="colName" minWidth="150.0" prefWidth="200.0" text="Category Name" />
                <TableColumn fx:id="colDes" prefWidth="450.0" text="Description" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
    </children>
</AnchorPane>