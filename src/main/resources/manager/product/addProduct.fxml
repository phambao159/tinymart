<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="550.0" prefWidth="650.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manager.product.AddProductController">
    <stylesheets>
        <URL value="@addproduct.css" />
    </stylesheets>
    <children>
        <VBox layoutX="30.0" layoutY="25.0" spacing="25.0" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="25.0">
            <children>
                <Label text="Add New Product" textFill="#27ae60">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
            
                <HBox spacing="35.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox alignment="TOP_CENTER" spacing="15.0">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="Product Image" />
                                <StackPane style="-fx-background-color: white; -fx-padding: 5; -fx-border-color: #dcdde1; -fx-border-radius: 5;">
                                    <children>
                                        <ImageView fx:id="imgPreview" fitHeight="180.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@../../../assets/default-product.png" />
                                            </image>
                                        </ImageView>
                                    </children>
                                </StackPane>
                                <Button mnemonicParsing="false" onAction="#onChooseImage" prefWidth="150.0" text="Choose Image" />
                            </children>
                        </VBox>
                  
                        <GridPane hgap="15.0" vgap="12.0" HBox.hgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="120.0" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="Name:" />
                                <TextField fx:id="txtName" prefHeight="35.0" promptText="Enter product name" GridPane.columnIndex="1" />
      
                                <Label text="Category:" GridPane.rowIndex="1" />
                                <ComboBox fx:id="cbCategory" maxWidth="1.7976931348623157E308" prefHeight="35.0" promptText="Select Category" GridPane.columnIndex="1" GridPane.rowIndex="1" />
      
                                <Label text="Unit:" GridPane.rowIndex="2" />
                                <TextField fx:id="txtUnit" prefHeight="35.0" promptText="e.g. Bottle, Cup" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      
                                <Label text="Status:" GridPane.rowIndex="3" />
                                <ComboBox fx:id="cbStatus" maxWidth="1.7976931348623157E308" prefHeight="35.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
      
                            </children>
                        </GridPane>
                    </children>
                </HBox>
            
                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onCancel" prefHeight="35.0" prefWidth="90.0" text="Cancel" />
                        <Button mnemonicParsing="false" onAction="#onSave" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Save Product" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>