<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="550.0" prefWidth="500.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manager.product.AddPromotionController">
    <stylesheets>
        <URL value="@addpromotion.css" />
    </stylesheets>
   <children>
      <VBox layoutX="30.0" layoutY="20.0" spacing="15.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0">
         <children>
            <Label fx:id="title" text="Add New Promotion" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            
            <GridPane vgap="10.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="320.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="80.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="3.0">
                     <children>
                        <Label text="Name:" />
                        <Label text="*" textFill="#e74c3c"><font><Font name="System Bold" size="14.0" /></font></Label>
                     </children>
                  </HBox>
                  <TextField fx:id="txtName" promptText="Promotion name" GridPane.columnIndex="1" />
                  
                  <HBox alignment="CENTER_LEFT" spacing="3.0" GridPane.rowIndex="1">
                     <children>
                        <Label text="Description:" />
                        
                     </children>
                  </HBox>
                  <TextArea fx:id="txtDescription" prefHeight="200.0" prefWidth="200.0" promptText="Enter details" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <HBox alignment="CENTER_LEFT" spacing="3.0" GridPane.rowIndex="2">
                     <children>
                        <Label text="Type:" />
                        <Label text="*" textFill="#e74c3c"><font><Font name="System Bold" size="14.0" /></font></Label>
                     </children>
                  </HBox>
                  <ComboBox fx:id="cbType" prefHeight="28.0" prefWidth="321.0" promptText="Select Type" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  
                  <HBox alignment="CENTER_LEFT" spacing="3.0" GridPane.rowIndex="3">
                     <children>
                        <Label text="Value:" />
                        <Label text="*" textFill="#e74c3c"><font><Font name="System Bold" size="14.0" /></font></Label>
                     </children>
                  </HBox>
                  <TextField fx:id="txtValue" promptText="Amount or Percentage" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  
                  <HBox alignment="CENTER_LEFT" spacing="3.0" GridPane.rowIndex="4">
                     <children>
                        <Label text="Start Date:" />
                        <Label text="*" textFill="#e74c3c"><font><Font name="System Bold" size="14.0" /></font></Label>
                     </children>
                  </HBox>
                  <DatePicker fx:id="dpStart" prefWidth="320.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  
                  <HBox alignment="CENTER_LEFT" spacing="3.0" GridPane.rowIndex="5">
                     <children>
                        <Label text="End Date:" />
                        <Label text="*" textFill="#e74c3c"><font><Font name="System Bold" size="14.0" /></font></Label>
                     </children>
                  </HBox>
                  <DatePicker fx:id="dpEnd" prefWidth="320.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                  
                  <HBox alignment="CENTER_LEFT" spacing="3.0" GridPane.rowIndex="6">
                     <children>
                        <Label text="Status:" />
                        <Label text="*" textFill="#e74c3c"><font><Font name="System Bold" size="14.0" /></font></Label>
                     </children>
                  </HBox>
                  <ComboBox fx:id="cbStatus" prefWidth="320.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />
               </children>
            </GridPane>
            
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button onAction="#onCancel" prefWidth="80.0" text="Cancel" />
                  <Button onAction="#onSave" prefWidth="80.0" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Save" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>