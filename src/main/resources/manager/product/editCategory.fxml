<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="380.0" prefWidth="450.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manager.product.EditCategoryController">
    <stylesheets>
        <URL value="@editcategory.css" />
    </stylesheets>
   <children>
      <VBox layoutX="30.0" layoutY="20.0" spacing="15.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="20.0">
         <children>
            <Label fx:id="title" text="Edit Category" textFill="#2980b9">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            
            <GridPane vgap="15.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="185.0" minWidth="10.0" prefWidth="110.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="290.0" minWidth="10.0" prefWidth="290.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Category ID:" />
                  <TextField fx:id="txtID" editable="false" style="-fx-background-color: #ecf0f1;" GridPane.columnIndex="1" />
                  
                  <HBox alignment="CENTER_LEFT" spacing="3.0" GridPane.rowIndex="1">
                     <children>
                        <Label text="Name:" />
                        <Label text="*" textFill="#e74c3c">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <TextField fx:id="txtName" promptText="Enter category name" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <Label text="Description:" GridPane.rowIndex="2" />
                  <TextArea fx:id="txtDescription" prefHeight="200.0" prefWidth="200.0" promptText="Enter description (optional)" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               </children>
            </GridPane>
            
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onDelete" prefWidth="80.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Delete" />
                  <Separator orientation="VERTICAL" prefHeight="30.0" />
                  <Button mnemonicParsing="false" onAction="#onCancel" prefWidth="80.0" text="Cancel" />
                  <Button mnemonicParsing="false" onAction="#onSave" prefWidth="80.0" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Save" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>