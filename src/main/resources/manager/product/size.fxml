<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="500.0" prefWidth="700.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manager.product.SizeController">
    <stylesheets>
        <URL value="@size.css" />
    </stylesheets>
    <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
         <children>
            
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <TextField fx:id="txtSearch" prefHeight="35.0" prefWidth="250.0" promptText="Search size name..." />
                  
                  <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f1f2f6; -fx-padding: 5 15; -fx-background-radius: 5;">
                     <children>
                        <RadioButton fx:id="rbActive" mnemonicParsing="false" selected="true" text="Active">
                           <toggleGroup>
                              <ToggleGroup fx:id="statusGroup" />
                           </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="rbInactive" mnemonicParsing="false" text="Inactive" toggleGroup="$statusGroup" />
                     </children>
                  </HBox>
                  
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#onAdd" prefHeight="35.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="+ NEW SIZE" />
               </children>
            </HBox>
            
            <TableView fx:id="tbSize" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colID" maxWidth="353.0" minWidth="60.0" prefWidth="301.0" text="ID" />
                <TableColumn fx:id="colType" prefWidth="325.0" text="Size Name / Type" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
    </children>
</AnchorPane>
