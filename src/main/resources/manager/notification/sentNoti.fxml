<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="2000.0" prefWidth="2000.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manager.notification.SentNotiController">
    <stylesheets>
        <URL value="@sentnoti.css" />
    </stylesheets>
    <children>
        <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <javafx.geometry.Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <HBox fx:id="NotiTool" prefHeight="32.0" spacing="10.0">
                    <children>
                        <TextField fx:id="tfSearch" onAction="#onSearch" prefWidth="300.0" promptText="Search Notification by content or receiver..." />
                        <Button mnemonicParsing="false" onAction="#onCreate" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="+ New Notification" />
                    </children>
                </HBox>
                
                <ScrollPane fx:id="viewSent" fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="sentContainer" spacing="10.0" style="-fx-background-color: white;">
                            <padding>
                                <javafx.geometry.Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</AnchorPane>