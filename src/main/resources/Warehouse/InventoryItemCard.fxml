<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Label?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.Warehouse.InventoryItemCardController"
      fx:id="cardRoot"
      spacing="5" alignment="CENTER"
      style="-fx-background-color: #f4f4f4; -fx-padding: 10; -fx-border-radius: 5; -fx-background-radius: 5;"
      prefWidth="180">

    <!-- Ảnh sản phẩm -->
    <ImageView fx:id="productImage" fitWidth="120" fitHeight="120" preserveRatio="true"/>

    <!-- Tên sản phẩm -->
    <Label fx:id="productName" styleClass="card-label"/>

    <!-- Size -->
    <Label fx:id="sizeType" styleClass="card-label"/>

    <!-- ✅ Tổng Stock -->
    <Label fx:id="stockLabel" styleClass="card-label"/>

</VBox>