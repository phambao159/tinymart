<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="root" stylesheets="@InventoryReport.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Warehouse.InventoryReportController">

    <!-- Header -->
    <top>
        <HBox spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" styleClass="label-title" text="Inventory Report" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Filter:" textFill="#ffffff">
            <font>
               <Font name="Tahoma" size="18.0" />
            </font></Label>
            <ComboBox fx:id="filterComboBox" prefWidth="150" />
        </HBox>
    </top>

    <!-- Center -->
    <center>
        <VBox spacing="15">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <!-- Alert Cards -->
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" styleClass="label-alert" text="Alerts" />
            <ScrollPane fitToWidth="true" prefHeight="220">
                <FlowPane fx:id="alertCardContainer" hgap="10" vgap="10">
                    <padding>
                        <Insets bottom="10" left="10" right="10" top="10" />
                    </padding>
                </FlowPane>
            </ScrollPane>

            <!-- Logs Table -->
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" styleClass="label-logs" text="Logs" />
            <TableView fx:id="logTable" prefHeight="300" prefWidth="950">
                <columns>
                    <TableColumn fx:id="colLogNo" prefWidth="75.0" text="No." />
                    <TableColumn fx:id="colLogProductName" prefWidth="202.0" text="Product Name" />
                    <TableColumn fx:id="colLogUpdateTime" prefWidth="176.0" text="Update Time" />
                    <TableColumn fx:id="colLogExpireDate" prefWidth="147.0" text="Expire Date" />
                    <TableColumn fx:id="colLogActionType" prefWidth="191.0" text="Action Type" />
                    <TableColumn fx:id="colLogUpdatedQuantity" prefWidth="158.0" text="Updated Quantity" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <Button onAction="#onRefresh" text="Refresh" />
            <Button onAction="#onClose" text="Close" />
        </HBox>
    </bottom>

</BorderPane>
