<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="450.0" prefWidth="550.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manager.supplier.EditSupplierController">
    <stylesheets>
        <URL value="@editsupplier.css" />
    </stylesheets>
   <children>
      <VBox alignment="TOP_CENTER" spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="20.0">
         <children>
            <Label text="EDIT SUPPLIER">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            
            <GridPane hgap="10.0" vgap="15.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="130.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="270.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="80.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Supplier ID:" />
                  <TextField fx:id="txtId" editable="false" style="-fx-background-color: #e9ecef;" GridPane.columnIndex="1" />
                  
                  <Label text="Supplier Name:" GridPane.rowIndex="1" />
                  <TextField fx:id="txtName" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <Label text="Contact Person:" GridPane.rowIndex="2" />
                  <TextField fx:id="txtContactPerson" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  
                  <Label text="Phone Number:" GridPane.rowIndex="3" />
                  <TextField fx:id="txtPhone" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               </children>
            </GridPane>
            
            <Label text="Address:" />
            <TextArea fx:id="txtAddress" prefHeight="80.0" wrapText="true" />
            
            <HBox alignment="CENTER" spacing="15.0">
               <children>
                  <Button onAction="#onUpdate" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;" text="UPDATE" />
                  <Button onAction="#onDelete" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold;" text="DELETE" />
                  <Button onAction="#onCancel" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #6c757d; -fx-text-fill: white;" text="CANCEL" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>