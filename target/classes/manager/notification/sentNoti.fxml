<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="2000.0" prefWidth="2000.0" styleClass="mainFxmlClass" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manager.notification.SentNotiController">
    <stylesheets>
        <URL value="@sentnoti.css"/>
    </stylesheets>
    <children>
      <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox fx:id="NotiTool" prefHeight="32.0" prefWidth="572.0" spacing="10.0">
               <children>
                  <TextField onAction="#onSearch" promptText="Search Notification" />
                  <Button mnemonicParsing="false" onAction="#onCreate" text="+ New Notification" />
               </children>
            </HBox>
            <ScrollPane fx:id="viewSent" fitToWidth="true" VBox.vgrow="ALWAYS">
               <content>
                  <FlowPane fx:id="sentContainer" prefHeight="64.0" prefWidth="570.0" vgap="15.0" />
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
