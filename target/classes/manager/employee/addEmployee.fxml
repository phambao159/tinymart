<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="550.0" prefWidth="500.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manager.employee.AddEmployeeController">
    <stylesheets>
        <URL value="@addemployee.css" />
    </stylesheets>
   <children>
      <VBox alignment="TOP_CENTER" spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="15.0">
         <children>
            <Label text="ADD NEW EMPLOYEE">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            
            <GridPane hgap="10.0" vgap="12.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="240.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Full Name:" />
                  <TextField fx:id="txtName" promptText="Nguyen Van A" GridPane.columnIndex="1" />
                  
                  <Label text="Birth Date:" GridPane.rowIndex="1" />
                  <DatePicker fx:id="dpDob" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <Label text="Phone:" GridPane.rowIndex="2" />
                  <TextField fx:id="txtPhone" promptText="090..." GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  
                  <Label text="Address:" GridPane.rowIndex="3" />
                  <TextField fx:id="txtAddress" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  
                  <Label text="Role:" GridPane.rowIndex="4" />
                  <ComboBox fx:id="cbRole" prefWidth="250.0" promptText="Select role" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  
                  <Label text="Base Salary:" GridPane.rowIndex="5" />
                  <TextField fx:id="txtSalary" promptText="e.g. 5000000" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                  
                  <Label text="Username:" GridPane.rowIndex="6" />
                  <TextField fx:id="txtUser" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                  
                  <Label text="Password:" GridPane.rowIndex="7" />
                  <PasswordField fx:id="txtPassword" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                  
                  <Label text="Hire Date:" GridPane.rowIndex="8" />
                  <DatePicker fx:id="dpHireDate" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="8" />
               </children>
            </GridPane>
            
            <HBox alignment="CENTER" spacing="25.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onSave" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" text="SAVE" />
                  <Button mnemonicParsing="false" onAction="#onClose" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #6c757d; -fx-text-fill: white;" text="CANCEL" />
               </children>
               <padding>
                  <Insets top="15.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>