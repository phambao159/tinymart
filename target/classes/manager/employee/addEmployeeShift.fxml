<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="450.0" prefWidth="500.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manager.employee.AddEmployeeShiftController">
    <stylesheets>
        <URL value="@addemployeeshift.css" />
    </stylesheets>
   <children>
      <VBox alignment="TOP_CENTER" spacing="25.0" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="25.0">
         <children>
            <Label text="ASSIGN NEW SHIFT">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            
            <GridPane hgap="15.0" vgap="20.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="130.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="290.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Select Employee:" />
                  <ComboBox fx:id="cbEmployee" prefWidth="300.0" promptText="-- Choose Employee --" GridPane.columnIndex="1" />
                  
                  <Label text="Select Shift:" GridPane.rowIndex="1" />
                  <ComboBox fx:id="cbShift" prefWidth="300.0" promptText="-- Choose Shift --" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <Label text="Work Date:" GridPane.rowIndex="2" />
                  <DatePicker fx:id="dpWorkDate" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  
                  <Label text="Initial Cash:" GridPane.rowIndex="3" />
                  <TextField fx:id="txtStartCash" prefWidth="300.0" promptText="0.00" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               </children>
            </GridPane>
            
            <HBox alignment="CENTER" spacing="30.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onSave" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" text="ASSIGN" />
                  <Button mnemonicParsing="false" onAction="#onClose" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #6c757d; -fx-text-fill: white;" text="CANCEL" />
               </children>
               <padding>
                  <Insets top="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>