<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="550.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manager.product.AddProductController">
    <stylesheets>
        <URL value="@addproduct.css" />
    </stylesheets>
   <children>
      <VBox layoutX="30.0" layoutY="25.0" spacing="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0">
         <children>
            <Label text="Add New Product" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            
            <HBox spacing="30.0">
               <children>
                  <VBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Label text="Product Image" />
                        <ImageView fx:id="imgPreview" fitHeight="150.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                           <image>
                              <Image url="@../../../assets/default-product.png" />
                           </image>
                        </ImageView>
                        <Button mnemonicParsing="false" onAction="#onChooseImage" text="Choose Image" />
                     </children>
                  </VBox>
                  
                  <GridPane hgap="10.0" vgap="15.0" HBox.hgrow="ALWAYS">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="100.0" minWidth="10.0" prefWidth="80.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <Label text="Name:" />
                        <TextField fx:id="txtName" promptText="Enter product name" GridPane.columnIndex="1" />
                        
                        <Label text="Category:" GridPane.rowIndex="1" />
                        <ComboBox fx:id="cbCategory" prefWidth="300.0" promptText="Select Category" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        
                        <Label text="Unit:" GridPane.rowIndex="2" />
                        <TextField fx:id="txtUnit" promptText="e.g. Bottle, Cup, Pack" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        
                        <Label text="Status:" GridPane.rowIndex="3" />
                        <ComboBox fx:id="cbStatus" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Promotion:" GridPane.rowIndex="4" />
                        <ComboBox fx:id="cbPromotion" prefWidth="300.0" promptText="Select Promotion (Optional)" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                     </children>
                  </GridPane>
               </children>
            </HBox>
            
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onCancel" prefWidth="100.0" text="Cancel" />
                  <Button mnemonicParsing="false" onAction="#onSave" prefWidth="100.0" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Save Product" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>   